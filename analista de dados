<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Analista de Dados — Leitura automática</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
  :root{
    --bg: #12161c;
    --panel: #181d25;
    --grid: #232a35;
    --ink: #d9e2ec;
    --dim: #7b8898;
    --phosphor: #7cffb2;
    --phosphor-dim: #2f5f47;
    --amber: #ffb454;
    --danger: #ff6b6b;
    --mono: 'IBM Plex Mono', 'SF Mono', Consolas, monospace;
    --sans: 'IBM Plex Sans', -apple-system, sans-serif;
  }
  @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap');

  *{ box-sizing:border-box; }
  body{
    margin:0;
    background:
      linear-gradient(var(--grid) 1px, transparent 1px) 0 0 / 100% 28px,
      var(--bg);
    color:var(--ink);
    font-family:var(--sans);
    min-height:100vh;
    padding:32px 20px 80px;
  }
  .wrap{ max-width:920px; margin:0 auto; }

  header{ margin-bottom:28px; }
  .eyebrow{
    font-family:var(--mono); font-size:12px; letter-spacing:.14em;
    color:var(--phosphor); text-transform:uppercase; margin:0 0 8px;
    display:flex; align-items:center; gap:8px;
  }
  .eyebrow::before{ content:''; width:7px; height:7px; border-radius:50%; background:var(--phosphor); box-shadow:0 0 8px var(--phosphor); }
  h1{ font-size:28px; margin:0 0 6px; font-weight:700; letter-spacing:-.01em; }
  .sub{ color:var(--dim); font-size:14px; max-width:60ch; line-height:1.5; }

  .panel{
    background:var(--panel);
    border:1px solid var(--grid);
    border-radius:10px;
    padding:22px;
    margin-bottom:20px;
  }
  .panel-title{
    font-family:var(--mono); font-size:11px; color:var(--dim);
    text-transform:uppercase; letter-spacing:.1em; margin:0 0 14px;
    display:flex; justify-content:space-between; align-items:center;
  }

  .drop{
    border:1.5px dashed var(--grid);
    border-radius:8px;
    padding:36px 20px;
    text-align:center;
    cursor:pointer;
    transition:border-color .15s, background .15s;
  }
  .drop:hover, .drop.drag{ border-color:var(--phosphor); background:#141a20; }
  .drop svg{ opacity:.5; margin-bottom:10px; }
  .drop p{ margin:0; color:var(--dim); font-size:13px; }
  .drop strong{ color:var(--ink); font-weight:600; }
  .drop input{ display:none; }

  .sample-row{ display:flex; gap:10px; justify-content:center; margin-top:14px; flex-wrap:wrap; }
  .sample-btn{
    font-family:var(--mono); font-size:11px; color:var(--phosphor);
    background:transparent; border:1px solid var(--phosphor-dim);
    padding:6px 12px; border-radius:20px; cursor:pointer;
  }
  .sample-btn:hover{ background:rgba(124,255,178,.08); }

  .meta-row{ display:flex; gap:16px; flex-wrap:wrap; font-family:var(--mono); font-size:12px; color:var(--dim); }
  .meta-row b{ color:var(--ink); }

  table{ width:100%; border-collapse:collapse; font-size:12.5px; font-family:var(--mono); }
  th,td{ text-align:left; padding:7px 10px; border-bottom:1px solid var(--grid); white-space:nowrap; }
  th{ color:var(--phosphor); font-weight:500; text-transform:uppercase; font-size:10.5px; letter-spacing:.05em; }
  td{ color:var(--dim); }
  .tbl-scroll{ overflow-x:auto; max-height:220px; overflow-y:auto; }

  select, button.action{
    font-family:var(--mono); font-size:12px; background:var(--bg);
    color:var(--ink); border:1px solid var(--grid); border-radius:6px;
    padding:8px 10px;
  }
  button.action{
    cursor:pointer; color:var(--bg); background:var(--phosphor);
    font-weight:600; border:none; display:flex; align-items:center; gap:8px;
  }
  button.action:hover{ filter:brightness(1.08); }
  button.action:disabled{ opacity:.5; cursor:not-allowed; }
  .controls{ display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin-bottom:16px; }
  .controls label{ font-family:var(--mono); font-size:11px; color:var(--dim); }

  canvas{ max-height:320px; }

  .insight{
    font-size:14.5px; line-height:1.7; color:var(--ink);
    white-space:pre-wrap;
  }
  .insight .cursor{ display:inline-block; width:7px; height:14px; background:var(--phosphor); vertical-align:middle; margin-left:2px; animation:blink 1s step-end infinite; }
  @keyframes blink{ 50%{opacity:0;} }

  .status{ font-family:var(--mono); font-size:12px; color:var(--dim); display:flex; align-items:center; gap:8px; }
  .dot{ width:6px; height:6px; border-radius:50%; background:var(--dim); }
  .dot.live{ background:var(--phosphor); box-shadow:0 0 6px var(--phosphor); animation:pulse 1.4s infinite; }
  @keyframes pulse{ 0%,100%{opacity:1;} 50%{opacity:.35;} }
  .error{ color:var(--danger); font-family:var(--mono); font-size:12.5px; }

  .empty{ color:var(--dim); font-size:13px; font-family:var(--mono); text-align:center; padding:30px 0; }
  footer{ text-align:center; color:var(--dim); font-family:var(--mono); font-size:11px; margin-top:30px; }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <p class="eyebrow">leitor de dados · insights automáticos</p>
    <h1>Analista de Dados</h1>
    <p class="sub">Envie um CSV, veja o gráfico se montar sozinho e peça um resumo em linguagem natural gerado por IA sobre o que os números mostram.</p>
  </header>

  <div class="panel">
    <p class="panel-title">01 · Fonte de dados</p>
    <div class="drop" id="drop">
      <input type="file" id="fileInput" accept=".csv">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#7cffb2" stroke-width="1.5"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"/></svg>
      <p><strong>Clique para enviar</strong> ou arraste um arquivo .csv aqui</p>
    </div>
    <div class="sample-row">
      <button class="sample-btn" data-sample="vendas">usar exemplo: vendas</button>
      <button class="sample-btn" data-sample="gastos">usar exemplo: gastos pessoais</button>
    </div>
  </div>

  <div class="panel">
    <p class="panel-title">ou digite os dados manualmente <span id="manualToggleHint" style="font-weight:400; text-transform:none; letter-spacing:0;">— linha por linha</span></p>

    <div class="controls" style="margin-bottom:12px;">
      <label for="colDefs">nomes das colunas (separados por vírgula)</label>
      <input type="text" id="colDefs" value="mes,categoria,valor"
        style="font-family:var(--mono); font-size:12px; background:var(--bg); color:var(--ink); border:1px solid var(--grid); border-radius:6px; padding:8px 10px; flex:1; min-width:200px;">
      <button class="sample-btn" id="setColsBtn" style="border-radius:6px;">definir colunas</button>
    </div>

    <div id="manualForm" class="controls" style="margin-bottom:14px;"></div>

    <div style="display:flex; gap:10px; align-items:center; margin-bottom:14px;">
      <button class="action" id="addRowBtn">+ adicionar linha</button>
      <span id="manualCount" style="font-family:var(--mono); font-size:12px; color:var(--dim);">0 linhas adicionadas</span>
    </div>

    <div class="tbl-scroll" id="manualTableWrap" style="display:none;">
      <table id="manualTable"></table>
    </div>

    <div style="height:12px"></div>
    <button class="action" id="useManualBtn" style="background:var(--amber);" disabled>▸ usar estes dados</button>
  </div>

  <div class="panel" id="dataPanel" style="display:none">
    <p class="panel-title">02 · Dados carregados <span id="metaInline"></span></p>
    <div class="tbl-scroll"><table id="dataTable"></table></div>
  </div>

  <div class="panel" id="chartPanel" style="display:none">
    <p class="panel-title">
      03 · Visualização
      <span class="controls" style="margin:0">
        <label for="colSelect">coluna numérica</label>
        <select id="colSelect"></select>
        <label for="groupSelect">agrupar por</label>
        <select id="groupSelect"></select>
      </span>
    </p>
    <canvas id="chart"></canvas>
  </div>

  <div class="panel" id="insightPanel" style="display:none">
    <p class="panel-title">
      04 · Leitura da IA
      <span class="status"><span class="dot" id="statusDot"></span><span id="statusText">ocioso</span></span>
    </p>
    <div class="controls">
      <label for="apiKey">chave da API do Gemini</label>
      <input type="password" id="apiKey" placeholder="cole aqui a sua chave (AIza...)"
        style="font-family:var(--mono); font-size:12px; background:var(--bg); color:var(--ink); border:1px solid var(--grid); border-radius:6px; padding:8px 10px; flex:1; min-width:220px;">
    </div>
    <p style="font-family:var(--mono); font-size:11px; color:var(--dim); margin:-6px 0 14px;">
      grátis em <a href="https://aistudio.google.com/apikey" target="_blank" style="color:var(--phosphor)">aistudio.google.com/apikey</a> · a chave fica só nesta página, nunca é enviada a nenhum servidor além do Google
    </p>
    <button class="action" id="analyzeBtn">▸ gerar insights</button>
    <div style="height:14px"></div>
    <div id="insightBox" class="empty">Carregue dados, cole sua chave gratuita do Gemini e clique em "gerar insights" para ver a leitura da IA aqui.</div>
  </div>

  <footer>feito com HTML · CSS · JS puro · Chart.js · PapaParse · API do Google Gemini</footer>
</div>

<script>
const SAMPLES = {
  vendas: `mes,categoria,valor
Jan,Eletronicos,12500
Jan,Roupas,7300
Jan,Alimentos,9800
Fev,Eletronicos,11200
Fev,Roupas,6900
Fev,Alimentos,10100
Mar,Eletronicos,15800
Mar,Roupas,5400
Mar,Alimentos,9500
Abr,Eletronicos,9100
Abr,Roupas,8200
Abr,Alimentos,11200
Mai,Eletronicos,17300
Mai,Roupas,7600
Mai,Alimentos,10800`,
  gastos: `mes,categoria,valor
Jan,Moradia,1800
Jan,Transporte,420
Jan,Lazer,300
Fev,Moradia,1800
Fev,Transporte,390
Fev,Lazer,550
Mar,Moradia,1850
Mar,Transporte,410
Mar,Lazer,180
Abr,Moradia,1800
Abr,Transporte,460
Abr,Lazer,620
Mai,Moradia,1900
Mai,Transporte,400
Mai,Lazer,240`
};

let rows = [], columns = [], chartInstance = null;

const drop = document.getElementById('drop');
const fileInput = document.getElementById('fileInput');
drop.addEventListener('click', () => fileInput.click());
drop.addEventListener('dragover', e => { e.preventDefault(); drop.classList.add('drag'); });
drop.addEventListener('dragleave', () => drop.classList.remove('drag'));
drop.addEventListener('drop', e => {
  e.preventDefault(); drop.classList.remove('drag');
  if (e.dataTransfer.files[0]) parseFile(e.dataTransfer.files[0]);
});
fileInput.addEventListener('change', e => { if (e.target.files[0]) parseFile(e.target.files[0]); });

document.querySelectorAll('.sample-btn[data-sample]').forEach(btn => {
  btn.addEventListener('click', () => {
    const csv = SAMPLES[btn.dataset.sample];
    parseCSVText(csv);
  });
});

// ---- Entrada manual, item por item ----
let manualCols = ['mes', 'categoria', 'valor'];
let manualRows = [];

const colDefsInput = document.getElementById('colDefs');
const manualForm = document.getElementById('manualForm');
const addRowBtn = document.getElementById('addRowBtn');
const useManualBtn = document.getElementById('useManualBtn');
const manualCountEl = document.getElementById('manualCount');
const manualTableWrap = document.getElementById('manualTableWrap');
const manualTable = document.getElementById('manualTable');

function buildManualForm(){
  manualForm.innerHTML = manualCols.map((c, i) => `
    <div style="display:flex; flex-direction:column; gap:4px;">
      <label style="font-family:var(--mono); font-size:10.5px; color:var(--dim); text-transform:uppercase;">${c}</label>
      <input type="text" class="manual-field" data-col="${c}"
        style="font-family:var(--mono); font-size:13px; background:var(--bg); color:var(--ink); border:1px solid var(--grid); border-radius:6px; padding:8px 10px; width:150px;">
    </div>
  `).join('');
}
buildManualForm();

document.getElementById('setColsBtn').addEventListener('click', () => {
  const cols = colDefsInput.value.split(',').map(c => c.trim()).filter(Boolean);
  if (!cols.length) return;
  manualCols = cols;
  manualRows = [];
  updateManualTable();
  buildManualForm();
});

function addManualRow(){
  const fields = manualForm.querySelectorAll('.manual-field');
  const row = {};
  let hasValue = false;
  fields.forEach(f => {
    let val = f.value.trim();
    if (val !== '') hasValue = true;
    const num = Number(val);
    row[f.dataset.col] = (val !== '' && !isNaN(num)) ? num : val;
  });
  if (!hasValue) return;
  manualRows.push(row);
  fields.forEach(f => f.value = '');
  fields[0]?.focus();
  updateManualTable();
}

addRowBtn.addEventListener('click', addManualRow);
manualForm.addEventListener('keydown', e => {
  if (e.key === 'Enter') { e.preventDefault(); addManualRow(); }
});

function updateManualTable(){
  manualCountEl.textContent = `${manualRows.length} linha${manualRows.length === 1 ? '' : 's'} adicionada${manualRows.length === 1 ? '' : 's'}`;
  useManualBtn.disabled = manualRows.length === 0;
  if (!manualRows.length){
    manualTableWrap.style.display = 'none';
    return;
  }
  manualTableWrap.style.display = 'block';
  const head = '<tr>' + manualCols.map(c => `<th>${c}</th>`).join('') + '<th></th></tr>';
  const body = manualRows.map((r, idx) => '<tr>' + manualCols.map(c => `<td>${r[c] ?? ''}</td>`).join('') +
    `<td><button class="sample-btn" data-remove="${idx}" style="padding:2px 8px; border-color:var(--danger); color:var(--danger);">remover</button></td></tr>`).join('');
  manualTable.innerHTML = head + body;
  manualTable.querySelectorAll('[data-remove]').forEach(btn => {
    btn.addEventListener('click', () => {
      manualRows.splice(Number(btn.dataset.remove), 1);
      updateManualTable();
    });
  });
}

useManualBtn.addEventListener('click', () => {
  if (!manualRows.length) return;
  loadData(manualRows.map(r => ({ ...r })));
});

function parseFile(file){
  Papa.parse(file, { header:true, dynamicTyping:true, skipEmptyLines:true,
    complete: res => loadData(res.data) });
}
function parseCSVText(text){
  const res = Papa.parse(text, { header:true, dynamicTyping:true, skipEmptyLines:true });
  loadData(res.data);
}

function loadData(data){
  rows = data.filter(r => Object.values(r).some(v => v !== null && v !== ''));
  if (!rows.length) return;
  columns = Object.keys(rows[0]);
  renderTable();
  renderChartControls();
  document.getElementById('dataPanel').style.display = 'block';
  document.getElementById('chartPanel').style.display = 'block';
  document.getElementById('insightPanel').style.display = 'block';
  document.getElementById('insightBox').className = 'empty';
  document.getElementById('insightBox').textContent = 'Dados prontos. Clique em "gerar insights" para ver a leitura da IA aqui.';
}

function renderTable(){
  document.getElementById('metaInline').textContent = ` · ${rows.length} linhas · ${columns.length} colunas`;
  const table = document.getElementById('dataTable');
  const head = '<tr>' + columns.map(c => `<th>${c}</th>`).join('') + '</tr>';
  const body = rows.slice(0, 12).map(r => '<tr>' + columns.map(c => `<td>${r[c] ?? ''}</td>`).join('') + '</tr>').join('');
  table.innerHTML = head + body;
}

function numericColumns(){
  return columns.filter(c => rows.every(r => r[c] === null || r[c] === '' || typeof r[c] === 'number'));
}

function renderChartControls(){
  const numCols = numericColumns();
  const catCols = columns.filter(c => !numCols.includes(c));
  const colSelect = document.getElementById('colSelect');
  const groupSelect = document.getElementById('groupSelect');
  colSelect.innerHTML = numCols.map(c => `<option value="${c}">${c}</option>`).join('') || '<option>—</option>';
  groupSelect.innerHTML = catCols.map(c => `<option value="${c}">${c}</option>`).join('') || '<option>—</option>';
  colSelect.onchange = drawChart;
  groupSelect.onchange = drawChart;
  drawChart();
}

function drawChart(){
  const valueCol = document.getElementById('colSelect').value;
  const groupCol = document.getElementById('groupSelect').value;
  if (!valueCol || !groupCol) return;

  const totals = {};
  rows.forEach(r => {
    const key = r[groupCol] ?? '—';
    const val = typeof r[valueCol] === 'number' ? r[valueCol] : 0;
    totals[key] = (totals[key] || 0) + val;
  });
  const labels = Object.keys(totals);
  const values = Object.values(totals);

  if (chartInstance) chartInstance.destroy();
  const ctx = document.getElementById('chart').getContext('2d');
  chartInstance = new Chart(ctx, {
    type: 'bar',
    data: {
      labels,
      datasets: [{
        label: valueCol,
        data: values,
        backgroundColor: 'rgba(124,255,178,0.55)',
        borderColor: '#7cffb2',
        borderWidth: 1,
        borderRadius: 4
      }]
    },
    options: {
      responsive: true,
      plugins: { legend: { display:false } },
      scales: {
        x: { ticks:{ color:'#7b8898', font:{ family:'IBM Plex Mono', size:11 } }, grid:{ color:'#232a35' } },
        y: { ticks:{ color:'#7b8898', font:{ family:'IBM Plex Mono', size:11 } }, grid:{ color:'#232a35' } }
      }
    }
  });
}

const analyzeBtn = document.getElementById('analyzeBtn');
const insightBox = document.getElementById('insightBox');
const statusDot = document.getElementById('statusDot');
const statusText = document.getElementById('statusText');

analyzeBtn.addEventListener('click', async () => {
  if (!rows.length) return;

  const apiKey = document.getElementById('apiKey').value.trim();
  if (!apiKey) {
    insightBox.className = 'error';
    insightBox.textContent = 'Cole sua chave gratuita do Gemini no campo acima (pegue em aistudio.google.com/apikey).';
    return;
  }

  analyzeBtn.disabled = true;
  statusDot.classList.add('live');
  statusText.textContent = 'analisando…';
  insightBox.className = 'insight';
  insightBox.innerHTML = '<span class="cursor"></span>';

  const sample = rows.slice(0, 60);
  const prompt = `Você é um analista de dados. Aqui está um CSV (colunas: ${columns.join(', ')}) com ${rows.length} linhas. Amostra em JSON:
${JSON.stringify(sample)}

Escreva, em português do Brasil, uma leitura curta e objetiva desses dados: 3 a 5 observações concretas (tendências, valores que se destacam, comparações entre categorias). Use linguagem direta, sem introdução nem conclusão genérica, formatado como uma lista com marcadores "-".`;

  try {
    const response = await fetch(
      `https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent?key=${apiKey}`,
      {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          contents: [{ parts: [{ text: prompt }] }]
        })
      }
    );
    const data = await response.json();
    if (data.error) throw new Error(data.error.message || 'Erro desconhecido');
    const text = data.candidates?.[0]?.content?.parts?.map(p => p.text).join('\n').trim();
    if (text) {
      const escaped = text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
      insightBox.innerHTML = escaped
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/\n/g, '<br>');
    } else {
      insightBox.textContent = 'Não consegui gerar uma leitura para esses dados.';
    }
  } catch (err) {
    insightBox.className = 'error';
    insightBox.textContent = 'Erro ao consultar a IA: ' + err.message;
  } finally {
    analyzeBtn.disabled = false;
    statusDot.classList.remove('live');
    statusText.textContent = 'ocioso';
  }
});
</script>
</body>
</html>